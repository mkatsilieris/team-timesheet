# Αντιγράψτε το σε .env και συμπληρώστε τις τιμές. Το .env δεν μπαίνει στο git.

# Emails που γίνονται διαχειριστές αυτόματα στην εγγραφή ή στην είσοδο (χωρισμένα με κόμμα).
ADMIN_EMAILS=

# SMTP για την αποστολή των κωδικών. Αν το SMTP_HOST μείνει κενό, ο κωδικός γράφεται
# στα logs του container (docker compose logs) αντί να σταλεί — χρήσιμο για τοπικό τεστ.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# 1 = STARTTLS (γίνεται αυτόματα στην πόρτα 587). Η πόρτα 465 χρησιμοποιεί SSL.
SMTP_STARTTLS=

# Ονόματα/IP με τα οποία ανοίγει η εφαρμογή μέσω HTTPS (Caddy), χωρισμένα με κόμμα.
TLS_HOSTS=localhost
# Αν οι χρήστες ανοίγουν την εφαρμογή με IP, βάλτε εδώ αυτή την IP (οι browsers δεν στέλνουν SNI για IP).
TLS_DEFAULT_SNI=localhost

# Το cookie στέλνεται μόνο σε HTTPS (default 1). Βάλτε 0 μόνο αν τρέξετε την εφαρμογή χωρίς το Caddy.
COOKIE_SECURE=1
